# Optional local database override. When unset, NEXUS uses ./nexus.db (SQLite).
NEXUS_DATABASE_URL=sqlite:///./nexus.db

# PostgreSQL example. Replace these placeholders locally; do not commit credentials.
# NEXUS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Optional list of browser origins allowed to call the API during local development.
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only needed when running the frontend and API on separate local ports.
VITE_API_BASE_URL=http://localhost:8080
